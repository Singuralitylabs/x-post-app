# --- X API (OAuth 1.0a user context) ---
# Generate these from the same X Developer App used by the existing GAS poster.
# Developer Portal > User authentication settings: enable OAuth 1.0a, Read and Write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Google Gemini API ---
GEMINI_API_KEY=
# Optional override; defaults to a cost-efficient flash model in config.py
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub (only needed for local runs of issue/publish; in Actions use GITHUB_TOKEN) ---
GITHUB_TOKEN=
# owner/repo, e.g. yamada/x-post-app
GITHUB_REPOSITORY=

# --- Behavior ---
# Number of post candidates to generate per run
CANDIDATE_COUNT=3
# Include source URL in the post body (true is more expensive on X API pay-per-use)
INCLUDE_URL=false
# Dry run: generate but do not post / do not create issues
DRY_RUN=false
